{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Chicago",
  "schedule": ["on monday"],
  "dependencyDashboard": true,
  "rebaseWhen": "conflicted",
  "minimumReleaseAge": "3 days",
  "prHourlyLimit": 0,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["on monday"]
  },
  "packageRules": [
    {
      "groupName": "github actions",
      "matchManagers": ["github-actions"]
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "groupName": "home assistant ecosystem",
      "matchPackageNames": [
        "python",
        "homeassistant",
        "pytest-homeassistant-custom-component",
        "bleak-retry-connector",
        "pytest-asyncio",
        "pytest-cov",
        "habluetooth",
        "serialx",
        "aioesphomeapi"
      ],
      "automerge": false,
      "rangeStrategy": "bump",
      "separateMajorMinor": false
    },
    {
      "description": "Hold Python at the version Home Assistant runs on. HA 2026.10 targets 3.14, and some locked deps (e.g. pyyaml 6.0.3) ship no 3.15 wheels. Raise this cap when HA moves to 3.15.",
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.15"
    }
  ],
  "assignees": ["kyleberry"]
}
