{
  "name": "Home Assistant Integration Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": true,
      "upgradePackages": true
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "mounts": [
    "source=${localEnv:HOME}/.claude/settings.json,target=/root/.claude/settings.json,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude/skills,target=/root/.claude/skills,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude/projects,target=/root/.claude/projects,type=bind,consistency=cached"
  ],
  "remoteUser": "root",
  // Resolve *.berry.house through AdGuard like the host does, so
  // mcp.berry.house reaches Caddy on the LAN. Docker's default resolvers
  // return the public Cloudflare address, which needs Cloudflare Access
  // headers the berry-mcp plugin doesn't send. 1.1.1.1 is the fallback
  // when AdGuard isn't reachable (off the LAN without WireGuard).
  "runArgs": ["--dns=192.168.86.2", "--dns=1.1.1.1"],
  "containerEnv": {
    "MCP_BEARER_TOKEN": "${localEnv:MCP_BEARER_TOKEN}"
  },
  "postCreateCommand": ".devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
